{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/apk",
        "destination": "/app-arm64-v8a-release.apk",
        "type": 302
      }
    ]
  },
  "database": {
    "rules": "firebase/database.rules.json"
  }
}