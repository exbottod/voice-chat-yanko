{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['title', 'ownerId'])",
        "seats": {
          "$seatId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['uid', 'muted'])"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt'])"
          }
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
