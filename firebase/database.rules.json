{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        "kursi": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "uid": {
              ".validate": "newData.val() == auth.uid"
            },
            "seat": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "micOn": {
              ".validate": "newData.isBoolean()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "roomsPub": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ownerId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "isOpen": {
          ".validate": "newData.isBoolean()"
        },
        "users": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}